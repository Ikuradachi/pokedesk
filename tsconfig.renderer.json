{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": [
    "src/common/**/*.ts",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.d.ts"
  ]
}
